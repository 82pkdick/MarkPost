		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/ejs": "^3.1.5",
		"@types/js-yaml": "^4.0.9",
		"@types/jsdom": "^28.0.1",
		"@types/node": "^24",
		"@types/turndown": "^5.0.6",
		"eslint": "^9.39.2",
