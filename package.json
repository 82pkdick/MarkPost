{
	"name": "markpost",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"start": "./scripts/start-app.sh",
		"start-server": "nodemon server.js",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
